<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SchemaFile>$(MSBuildThisFileDirectory)..\..\schema\flagd-schema.json</SchemaFile>
    <GeneratedSchemaFile>$(MSBuildThisFileDirectory)Generated\FlagdSchema.g.cs</GeneratedSchemaFile>
    <GeneratorProject>$(MSBuildThisFileDirectory)..\OpenFeatureManager.SchemaGenerator\OpenFeatureManager.SchemaGenerator.csproj</GeneratorProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.3" />
  </ItemGroup>

  <!-- Build and run the schema generator before compilation -->
  <Target Name="GenerateSchemaClasses" BeforeTargets="CoreCompile"
          Inputs="$(SchemaFile)"
          Outputs="$(GeneratedSchemaFile)">
    <Exec Command="dotnet run --project &quot;$(GeneratorProject)&quot; -- &quot;$(SchemaFile)&quot; &quot;$(GeneratedSchemaFile)&quot;"
          ConsoleToMsBuild="true" />
  </Target>

</Project>
