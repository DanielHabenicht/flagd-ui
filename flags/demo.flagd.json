{
  "$evaluators": {
    "isAnother": {
      "in": [
        {
          "var": "environment"
        },
        [
          "prod"
        ]
      ]
    },
    "isTest": {
      "in": [
        {
          "var": "environment"
        },
        [
          "aloas"
        ]
      ]
    }
  },
  "$schema": "https://flagd.dev/schema/v0/flags.json",
  "flags": {
    "background-color": {
      "defaultVariant": "yellow",
      "state": "ENABLED",
      "variants": {
        "yellow": "#FFFF00"
      }
    },
    "show-welcome-banner": {
      "defaultVariant": "off",
      "state": "ENABLED",
      "targeting": {
        "if": [
          {
            "$ref": "isTest"
          },
          "test",
          {
            "if": [
              {
                "$ref": "isAnother"
              },
              "another",
              "off"
            ]
          }
        ]
      },
      "variants": {
        "another": false,
        "off": false,
        "test": true
      }
    },
    "test": {
      "defaultVariant": "on",
      "metadata": {
        "test": "123"
      },
      "state": "ENABLED",
      "targeting": {
        "if": [
          {
            "<=": [
              {
                "var": "$flagd.timestamp"
              },
              1770854400
            ]
          },
          "on",
          "off"
        ]
      },
      "variants": {
        "off": false,
        "on": true
      }
    },
    "testa": {
      "defaultVariant": "off",
      "state": "ENABLED",
      "targeting": {
        "if": [
          {
            ">=": [
              {
                "var": "$flagd.timestamp"
              },
              1771369200
            ]
          },
          {
            "if": [
              {
                "$ref": "isAnother"
              },
              "another",
              {
                "if": [
                  {
                    "$ref": "isTest"
                  },
                  "test",
                  "off"
                ]
              }
            ]
          },
          "off"
        ]
      },
      "variants": {
        "another": true,
        "off": false,
        "test": false
      }
    }
  },
  "metadata": {
    "asdasd": "asdasdasdasdasdasd"
  }
}