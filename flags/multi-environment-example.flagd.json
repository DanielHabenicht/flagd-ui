  "$schema": "https://flagd.dev/schema/v0/flags.json",
  "flags": {
    "api-timeout-ms": {
      "defaultVariant": "on",
      "state": "ENABLED",
      "variants": {
        "on": false
      }
    },
    "background-color": {
      "defaultVariant": "default",
      "state": "ENABLED",
      "variants": {
        "default": "#0000FF"
      }
    },
    "experimental-ai-features": {
      "defaultVariant": "on",
      "state": "ENABLED",
      "targeting": {
        "if": [
          {
            "and": [
              {
                "in": [
                  {
                    "var": "environment"
                  },
                  [
                    "development"
                  ]
                ]
              },
              {
                ">=": [
                  {
                    "var": "$flagd.timestamp"
                  },
                  1770768000
                ]
              }
            ]
          },
          "on",
          "off"
        ]
      },
      "variants": {
        "on": false
      }
    },
    "new-checkout-flow": {
      "defaultVariant": "on",
      "state": "ENABLED",
      "variants": {
        "on": false
      }
    }
  },
